{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ANVESHA LDR perception annotation",
  "type": "object",
  "required": ["image_id", "experiment_id", "provenance", "split", "components", "pins", "wire_endpoints", "connections", "frame", "expected_state", "predicted_state"],
  "properties": {
    "image_id": {"type": ["string", "null"]},
    "experiment_id": {"const": "ldr_001"},
    "provenance": {"enum": ["synthetic", "test_fixture", "real"]},
    "split": {"enum": ["train", "validation", "test", "golden"]},
    "session_id": {"type": "string"},
    "image_path": {"type": ["string", "null"]},
    "metadata": {"type": "object", "additionalProperties": true},
    "frame": {
      "type": "object",
      "required": ["usable", "occluded"],
      "properties": {
        "usable": {"type": "boolean"},
        "occluded": {"type": "boolean"},
        "quality_reason": {"type": "string"}
      }
    },
    "components": {"type": "array", "items": {"$ref": "#/$defs/component"}},
    "pins": {"type": "array", "items": {"$ref": "#/$defs/pin"}},
    "wire_endpoints": {"type": "array", "items": {"$ref": "#/$defs/endpoint"}},
    "connections": {"type": "array", "items": {"$ref": "#/$defs/connection"}},
    "expected_connections": {"type": "array", "items": {"type": "string"}},
    "predicted_connections": {"type": "array", "items": {"type": "string"}},
    "expected_components": {"type": "array", "items": {"type": "string"}},
    "predicted_components": {"type": "array", "items": {"type": "string"}},
    "expected_pins": {"type": "array", "items": {"type": "string"}},
    "predicted_pins": {"type": "array", "items": {"type": "string"}},
    "expected_endpoints": {"type": "array", "items": {"type": "string"}},
    "predicted_endpoints": {"type": "array", "items": {"type": "string"}},
    "expected_evidence_statuses": {"type": "array", "items": {"type": "string"}},
    "predicted_evidence_statuses": {"type": "array", "items": {"type": "string"}},
    "expected_state": {"enum": ["PASS", "WARNING", "DEVIATION", "INSUFFICIENT_EVIDENCE"]},
    "predicted_state": {"enum": ["PASS", "WARNING", "DEVIATION", "INSUFFICIENT_EVIDENCE"]}
  },
  "$defs": {
    "component": {
      "type": "object",
      "required": ["label", "confidence", "status"],
      "properties": {
        "label": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "status": {"enum": ["OBSERVED", "INFERRED", "UNCERTAIN", "OCCLUDED", "MISSING"]}
      },
      "additionalProperties": false
    },
    "pin": {
      "type": "object",
      "required": ["component_label", "pin_label", "position", "confidence", "status"],
      "properties": {
        "component_label": {"type": "string"},
        "pin_label": {"type": "string"},
        "position": {"$ref": "#/$defs/point"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "status": {"enum": ["OBSERVED", "INFERRED", "UNCERTAIN", "OCCLUDED", "MISSING"]}
      },
      "additionalProperties": false
    },
    "endpoint": {
      "type": "object",
      "required": ["wire_id", "position", "confidence", "status"],
      "properties": {
        "wire_id": {"type": "string"},
        "position": {"$ref": "#/$defs/point"},
        "component_label": {"type": ["string", "null"]},
        "pin_label": {"type": ["string", "null"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "status": {"enum": ["OBSERVED", "INFERRED", "UNCERTAIN", "OCCLUDED", "MISSING"]}
      },
      "additionalProperties": false
    },
    "connection": {
      "type": "object",
      "required": ["from_component", "from_pin", "to_component", "to_pin", "confidence", "status"],
      "properties": {
        "from_component": {"type": "string"},
        "from_pin": {"type": "string"},
        "to_component": {"type": ["string", "null"]},
        "to_pin": {"type": ["string", "null"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "status": {"enum": ["OBSERVED", "INFERRED", "UNCERTAIN", "OCCLUDED", "MISSING"]}
      },
      "additionalProperties": false
    },
    "point": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": {"type": "number", "minimum": 0, "maximum": 1},
        "y": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
